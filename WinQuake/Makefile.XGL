# Native XGL renderer for 32-bit Solaris/SPARC. Requires GNU make and GCC.
# Existing software, XIL and OpenGL build recipes remain independent.

CC = gcc
CFLAGS ?= -O2 -ffast-math -fno-strict-aliasing -fcommon
CPPFLAGS ?=
LDFLAGS ?=
LANGFLAGS ?=
WARNFLAGS ?= -Wall -W
XGLHOME ?= /opt/SUNWits/Graphics-sw/xgl
OPENWINHOME ?= /usr/openwin
BUILD_DIR ?= build/xgl
HOST_CC ?= cc
HOST_X11_INCLUDE ?=
HOST_CFLAGS ?= -O2 -ffast-math -std=gnu89 -Wall -Wextra
TEST_BUILD_DIR ?= build/xgl-tests

XGL_CPPFLAGS = -DXGLQUAKE -D__EXTENSIONS__ -I$(XGLHOME)/include -I$(OPENWINHOME)/include
XGL_LDFLAGS = -L$(XGLHOME)/lib -L$(OPENWINHOME)/lib -R$(XGLHOME)/lib:$(OPENWINHOME)/lib
XGL_LIBS ?= -lxgl -lX11 -lXext -ldga -ldl -lsocket -lnsl -lthread -lm

COMMON_SOURCES = chase.c cl_demo.c cl_input.c cl_main.c cl_parse.c cl_tent.c \
    cmd.c common.c console.c crc.c cvar.c host.c host_cmd.c keys.c menu.c \
    mathlib.c net_dgrm.c net_loop.c net_main.c net_vcr.c net_udp.c net_bsd.c \
    pr_cmds.c pr_edict.c pr_exec.c r_part.c sbar.c sv_main.c sv_phys.c \
    sv_move.c sv_user.c zone.c view.c wad.c world.c gl_refrag.c \
    cd_null.c sys_sun.c snd_dma.c snd_mem.c snd_mix.c
XGL_SOURCES = xgl_model.c xgl_mesh.c xgl_texture.c xgl_rmain.c xgl_world.c \
    xgl_light.c xgl_draw.c xgl_vid.c xgl_backend.c xgl_screen.c \
    xgl_effects.c xgl_entities.c xgl_filesystem.c xgl_snd_sun.c xgl_profile.c
SOURCES = $(COMMON_SOURCES) $(XGL_SOURCES)
OBJECTS = $(SOURCES:%.c=$(BUILD_DIR)/%.o)
DEPS = $(OBJECTS:.o=.d)
MISSING_DEPS = $(filter-out $(wildcard $(DEPS)),$(DEPS))
# Host test recipes compile several sources at once and retain their own
# conservative header prerequisites.
HEADERS = $(wildcard *.h)

.DELETE_ON_ERROR:
.PHONY: all native sdk-check clean check host-check native-contract-check print-sources missing-deps
all: native

native: sdk-check
	$(MAKE) -f Makefile.XGL xglquake

sdk-check:
	@test -f "$(XGLHOME)/include/xgl/xgl.h" || { \
	    echo "Missing XGL SDK header; set XGLHOME to the native SDK installation." >&2; exit 1; }
	@test -f "$(OPENWINHOME)/include/X11/Xlib.h" || { \
	    echo "Missing OpenWindows headers; set OPENWINHOME to their installation." >&2; exit 1; }

# Older builds have no .d files. Rebuild those objects once to establish
# complete dependencies, also recovering safely if a .d file is removed.
ifneq ($(MISSING_DEPS),)
$(MISSING_DEPS:.d=.o): missing-deps
endif
missing-deps:

$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(BUILD_DIR)
	$(CC) $(CPPFLAGS) $(XGL_CPPFLAGS) $(CFLAGS) $(LANGFLAGS) $(WARNFLAGS) \
	    -MMD -MP -MF $(@:.o=.d.tmp) -MT $@ -c $< -o $@
	@mv -f $(@:.o=.d.tmp) $(@:.o=.d)

xglquake: $(OBJECTS)
	$(CC) $(LDFLAGS) $(XGL_LDFLAGS) -o $@ $(OBJECTS) $(XGL_LIBS)

# Modern development host only; uses handwritten platform contracts and
# the caller's XGL SDK headers. This is not native graphics/ABI validation.
host-check:
	python3 xgl_tests/host_check.py --cc "$(HOST_CC)" --sdk "$(XGLHOME)" \
	    --x11 "$(HOST_X11_INCLUDE)" $(SOURCES)

# CPU/adapter regression tests; modern host only, no SDK or game data needed.
check: $(TEST_BUILD_DIR)/test_texture $(TEST_BUILD_DIR)/test_mesh \
       $(TEST_BUILD_DIR)/test_draw $(TEST_BUILD_DIR)/test_entities \
       $(TEST_BUILD_DIR)/test_world $(TEST_BUILD_DIR)/test_input \
       $(TEST_BUILD_DIR)/test_filesystem $(TEST_BUILD_DIR)/test_audio \
       $(TEST_BUILD_DIR)/test_profile $(TEST_BUILD_DIR)/test_effects \
       $(TEST_BUILD_DIR)/test_alias_colors
	./$(TEST_BUILD_DIR)/test_texture
	./$(TEST_BUILD_DIR)/test_mesh
	./$(TEST_BUILD_DIR)/test_draw
	./$(TEST_BUILD_DIR)/test_entities
	./$(TEST_BUILD_DIR)/test_world
	./$(TEST_BUILD_DIR)/test_input
	./$(TEST_BUILD_DIR)/test_filesystem
	./$(TEST_BUILD_DIR)/test_audio
	./$(TEST_BUILD_DIR)/test_profile
	./$(TEST_BUILD_DIR)/test_effects
	./$(TEST_BUILD_DIR)/test_alias_colors

$(TEST_BUILD_DIR)/test_alias_colors: xgl_tests/test_alias_colors.c xgl_entities.c xgl_texture.c mathlib.c $(HEADERS)
	@mkdir -p $(TEST_BUILD_DIR)
	$(HOST_CC) $(HOST_CFLAGS) -DXGLQUAKE -I. -ffunction-sections -fdata-sections \
	    -o $@ xgl_tests/test_alias_colors.c xgl_texture.c mathlib.c -Wl,--gc-sections -lm

$(TEST_BUILD_DIR)/test_effects: xgl_tests/test_effects.c xgl_effects.c $(HEADERS)
	@mkdir -p $(TEST_BUILD_DIR)
	$(HOST_CC) $(HOST_CFLAGS) -DXGLQUAKE -I. -o $@ xgl_tests/test_effects.c -lm

$(TEST_BUILD_DIR)/test_audio: xgl_tests/test_audio.c xgl_snd_sun.c $(HEADERS) \
                             xgl_tests/include/sys/audioio.h
	@mkdir -p $(TEST_BUILD_DIR)
	$(HOST_CC) $(HOST_CFLAGS) -DXGLQUAKE -I. -Ixgl_tests/include \
	    -o $@ xgl_tests/test_audio.c -lm

$(TEST_BUILD_DIR)/test_profile: xgl_tests/test_profile.c xgl_profile.c $(HEADERS)
	@mkdir -p $(TEST_BUILD_DIR)
	$(HOST_CC) $(HOST_CFLAGS) -DXGLQUAKE -I. \
	    -o $@ xgl_tests/test_profile.c xgl_profile.c -lm

$(TEST_BUILD_DIR)/test_filesystem: xgl_tests/test_filesystem.c xgl_filesystem.c common.c crc.c $(HEADERS)
	@mkdir -p $(TEST_BUILD_DIR)
	$(HOST_CC) $(HOST_CFLAGS) -DXGLQUAKE -I. -ffunction-sections -fdata-sections \
	    -o $@ xgl_tests/test_filesystem.c xgl_filesystem.c crc.c -Wl,--gc-sections -lm

$(TEST_BUILD_DIR)/test_texture: xgl_tests/test_texture.c xgl_texture.c $(HEADERS)
	@mkdir -p $(TEST_BUILD_DIR)
	$(HOST_CC) $(HOST_CFLAGS) -DXGLQUAKE -I. -o $@ xgl_tests/test_texture.c xgl_texture.c -lm

$(TEST_BUILD_DIR)/test_mesh: xgl_tests/test_mesh.c xgl_mesh.c $(HEADERS)
	@mkdir -p $(TEST_BUILD_DIR)
	$(HOST_CC) $(HOST_CFLAGS) -DXGLQUAKE -I. -o $@ xgl_tests/test_mesh.c xgl_mesh.c -lm

$(TEST_BUILD_DIR)/test_draw: xgl_tests/test_draw.c xgl_draw.c $(HEADERS)
	@mkdir -p $(TEST_BUILD_DIR)
	$(HOST_CC) $(HOST_CFLAGS) -DXGLQUAKE -I. -o $@ xgl_tests/test_draw.c -lm

$(TEST_BUILD_DIR)/test_entities: xgl_tests/test_entities.c xgl_entities.c mathlib.c $(HEADERS)
	@mkdir -p $(TEST_BUILD_DIR)
	$(HOST_CC) $(HOST_CFLAGS) -DXGLQUAKE -I. -ffunction-sections -fdata-sections \
	    -o $@ xgl_tests/test_entities.c mathlib.c -Wl,--gc-sections -lm

$(TEST_BUILD_DIR)/test_world: xgl_tests/test_world.c xgl_world.c xgl_light.c mathlib.c $(HEADERS)
	@mkdir -p $(TEST_BUILD_DIR)
	$(HOST_CC) $(HOST_CFLAGS) -DXGLQUAKE -I. -ffunction-sections -fdata-sections \
	    -o $@ xgl_tests/test_world.c xgl_light.c mathlib.c -Wl,--gc-sections -lm

$(TEST_BUILD_DIR)/test_input: xgl_tests/test_input.c xgl_vid.c $(HEADERS) \
                           $(wildcard xgl_tests/include/X11/*.h)
	@mkdir -p $(TEST_BUILD_DIR)
	$(HOST_CC) $(HOST_CFLAGS) -DXGLQUAKE -I. \
	    $(if $(HOST_X11_INCLUDE),-I$(HOST_X11_INCLUDE)) -Ixgl_tests/include \
	    -ffunction-sections -fdata-sections -o $@ xgl_tests/test_input.c -Wl,--gc-sections -lm

# Optional host state/matrix test compiled against the real XGL SDK headers.
native-contract-check: $(TEST_BUILD_DIR)/test_backend
	./$(TEST_BUILD_DIR)/test_backend

$(TEST_BUILD_DIR)/test_backend: xgl_tests/test_backend.c xgl_backend.c $(HEADERS)
	@mkdir -p $(TEST_BUILD_DIR)
	$(HOST_CC) $(HOST_CFLAGS) -DXGLQUAKE -D__EXTENSIONS__ -I. \
	    -I$(XGLHOME)/include $(if $(HOST_X11_INCLUDE),-I$(HOST_X11_INCLUDE)) \
	    -Ixgl_tests/include -Wno-unknown-pragmas -ffunction-sections -fdata-sections \
	    -o $@ xgl_tests/test_backend.c -Wl,--gc-sections -lm

print-sources:
	@echo $(SOURCES)

clean:
	rm -f $(OBJECTS) $(DEPS) $(DEPS:.d=.d.tmp) xglquake

# Keep this after the default target; a dependency file must not change it.
# Read existing files only: missing ones are generated with their objects.
-include $(wildcard $(DEPS))
